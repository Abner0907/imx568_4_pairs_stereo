					inherent_gain = "1";
					pix_clk_hz = "297000000";	/* 4 x 74.25 MHz, >= peak pixel rate */
					serdes_pix_clk_hz = "833333333";
					gain_factor = "10";
					min_gain_val = "0";
					max_gain_val = "480";	/* 48.0 dB */
					step_gain_val = "1";
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
