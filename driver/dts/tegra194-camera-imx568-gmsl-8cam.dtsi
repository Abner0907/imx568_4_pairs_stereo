		i2c@1 {	/* stereo pair 1 (rear) */
			reg = <1>;
			i2c-mux,deselect-on-exit;
			#address-cells = <1>;
			#size-cells = <0>;

			dser1: max9296@48 {
				compatible = "maxim,max9296";
				reg = <0x48>;
				csi-mode = "2x4";
				max-src = <2>;
				reset-gpios = <&tegra_main_gpio DES1_PWDN_GPIO GPIO_ACTIVE_HIGH>;
			};
			ser1_prim: max9295_prim@62 {
				compatible = "maxim,max9295";
				reg = <0x62>;		/* power-on address (CFG strap) */
				is-prim-ser;
			};
			ser1_a: max9295_a@40 {
				compatible = "maxim,max9295";
				reg = <0x40>;
				nvidia,gmsl-dser-device = <&dser1>;
			};
			ser1_b: max9295_b@60 {
				compatible = "maxim,max9295";
				reg = <0x60>;
				nvidia,gmsl-dser-device = <&dser1>;
			};

			imx568_2: imx568_a@1b {
				compatible = "sony,imx568";
				reg = <0x1b>;		/* proxy address seen by Tegra */
				def-addr = <0x1a>;		/* IMX568 common 2nd address (DS 14.4) */
				devnode = "video2";
				physical_w = "6.708";
				physical_h = "5.612";
				sensor_model = "imx568";
				use_sensor_mode_id = "true";
				post_crop_frame_drop = "0";
