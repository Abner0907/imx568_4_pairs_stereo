	i2c@3180000 {			/* CAM_I2C on the Xavier camera connector */
		tca9546@70 {
			compatible = "nxp,pca9546";
			reg = <0x70>;
			#address-cells = <1>;
			#size-cells = <0>;
			skip_mux_detect = "yes";
			vcc_lp = "vcc";
			force_bus_start = <30>;	/* mux channels become i2c-30..33 */

		i2c@0 {	/* stereo pair 0 (front) */
			reg = <0>;
			i2c-mux,deselect-on-exit;
			#address-cells = <1>;
			#size-cells = <0>;

			dser0: max9296@48 {
				compatible = "maxim,max9296";
				reg = <0x48>;
				csi-mode = "2x4";
				max-src = <2>;
				reset-gpios = <&tegra_main_gpio DES0_PWDN_GPIO GPIO_ACTIVE_HIGH>;
			};
			ser0_prim: max9295_prim@62 {
				compatible = "maxim,max9295";
				reg = <0x62>;		/* power-on address (CFG strap) */
				is-prim-ser;
			};
			ser0_a: max9295_a@40 {
				compatible = "maxim,max9295";
				reg = <0x40>;
				nvidia,gmsl-dser-device = <&dser0>;
			};
			ser0_b: max9295_b@60 {
				compatible = "maxim,max9295";
				reg = <0x60>;
				nvidia,gmsl-dser-device = <&dser0>;
			};

			imx568_0: imx568_a@1b {
				compatible = "sony,imx568";
				reg = <0x1b>;		/* proxy address seen by Tegra */
				def-addr = <0x1a>;		/* IMX568 common 2nd address (DS 14.4) */
				devnode = "video0";
				physical_w = "6.708";
				physical_h = "5.612";
				sensor_model = "imx568";
				use_sensor_mode_id = "true";
				post_crop_frame_drop = "0";
				nvidia,gmsl-ser-device = <&ser0_a>;
				nvidia,gmsl-dser-device = <&dser0>;

				imx568,sync-mode = "fast-trigger";	/* or "master" for bring-up */
				imx568,mfp-en = <SER_MFP_EN_1V1 SER_MFP_EN_1V8 SER_MFP_EN_2V9 SER_MFP_EN_3V3>;
				imx568,mfp-xclr = <SER_MFP_XCLR>;
				imx568,mfp-xtrig = <SER_MFP_XTRIG>;
				imx568,mfp-tout0 = <SER_MFP_TOUT0>;
				imx568,gmsl-gpio-id-trig = <0>;
				imx568,gmsl-gpio-id-tout0 = <1>;
				/* imx568,dser-phy-rate-mbps = <2000>;  needed for 2448x2048 above ~25 fps */
				imx568,dser-init-regs = /bits/ 16 <DES_GPIO_A(DES_TRIG_MFP) 0x03
								   DES_GPIO_B(DES_TRIG_MFP) 0x00>;

				mode0 {	/* 1224x1024 RAW12 (mono, read as Y12) */
					mclk_khz = "74250";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					dynamic_pixel_bit_depth = "12";
					csi_pixel_bit_depth = "12";
					mode_type = "bayer";
					pixel_phase = "rggb";	/* mono sensor: no CFA, ISP not used */
					active_w = "1224";
					active_h = "1024";
					readout_orientation = "0";
					line_length = "2400";	/* 4 x HMAX: 1H = line_length / pix_clk_hz */
					inherent_gain = "1";
					pix_clk_hz = "297000000";	/* 4 x 74.25 MHz, >= peak pixel rate */
					serdes_pix_clk_hz = "833333333";
					gain_factor = "10";
					min_gain_val = "0";
					max_gain_val = "480";	/* 48.0 dB */
					step_gain_val = "1";
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					framerate_factor = "1000000";
					min_framerate = "1000000";
					max_framerate = "60000000";
					step_framerate = "1";
					default_framerate = "30000000";
					exposure_factor = "1000000";
					min_exp_time = "10";
					max_exp_time = "15000";
					step_exp_time = "1";
					default_exp_time = "5000";
					embedded_metadata_height = "0";
				};
				mode1 {	/* 2448x2048 RAW12 (mono, read as Y12) */
					mclk_khz = "74250";
					num_lanes = "4";
					tegra_sinterface = "serial_a";
					vc_id = "0";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					dynamic_pixel_bit_depth = "12";
					csi_pixel_bit_depth = "12";
					mode_type = "bayer";
					pixel_phase = "rggb";	/* mono sensor: no CFA, ISP not used */
					active_w = "2448";
					active_h = "2048";
					readout_orientation = "0";
					line_length = "4400";	/* 4 x HMAX: 1H = line_length / pix_clk_hz */
					inherent_gain = "1";
					pix_clk_hz = "297000000";	/* 4 x 74.25 MHz, >= peak pixel rate */
					serdes_pix_clk_hz = "833333333";
					gain_factor = "10";
					min_gain_val = "0";
					max_gain_val = "480";	/* 48.0 dB */
					step_gain_val = "1";
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					framerate_factor = "1000000";
					min_framerate = "1000000";
					max_framerate = "30000000";
					step_framerate = "1";
					default_framerate = "30000000";
					exposure_factor = "1000000";
					min_exp_time = "10";
					max_exp_time = "30000";
					step_exp_time = "1";
					default_exp_time = "5000";
					embedded_metadata_height = "0";
				};

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						imx568_out0: endpoint {
							vc-id = <0>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&imx568_csi_in0>;
						};
					};
				};

				gmsl-link {
					src-csi-port = "b";	/* MAX9295A CSI input */
					dst-csi-port = "a";	/* MAX9296A CSI output port A (x4) */
					serdes-csi-link = "a";
					csi-mode = "1x4";
					st-vc = <0>;
					vc-id = <0>;
					num-lanes = <4>;
					streams = "raw12";
				};
			};

			imx568_1: imx568_b@1c {
