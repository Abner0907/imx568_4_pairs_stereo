	tegra-camera-platform {
		compatible = "nvidia, tegra-camera-platform";
		num_csi_lanes = <16>;
		max_lane_speed = <2500000>;
		min_bits_per_pixel = <12>;
		vi_peak_byte_per_pixel = <2>;
		vi_bw_margin_pct = <25>;
		max_pixel_rate = <2400000>;
		isp_peak_byte_per_pixel = <5>;
		isp_bw_margin_pct = <25>;
		modules {
			module0 {
				badge = "imx568_front_left";
				position = "front";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 30-001b";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@0/imx568_a@1b";
				};
			};
			module1 {
				badge = "imx568_front_right";
				position = "rear";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 30-001c";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@0/imx568_b@1c";
				};
			};
			module2 {
				badge = "imx568_rear_left";
				position = "topleft";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 31-001b";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@1/imx568_a@1b";
				};
			};
			module3 {
				badge = "imx568_rear_right";
				position = "topright";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 31-001c";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@1/imx568_b@1c";
				};
			};
			module4 {
				badge = "imx568_left_left";
				position = "bottomleft";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 32-001b";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@2/imx568_a@1b";
				};
			};
			module5 {
				badge = "imx568_left_right";
				position = "bottomright";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 32-001c";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@2/imx568_b@1c";
				};
			};
			module6 {
				badge = "imx568_right_left";
				position = "centerleft";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 33-001b";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@3/imx568_a@1b";
				};
			};
			module7 {
				badge = "imx568_right_right";
