					mode_type = "bayer";
					pixel_phase = "rggb";	/* mono sensor: no CFA, ISP not used */
					active_w = "2448";
					active_h = "2048";
					readout_orientation = "0";
					line_length = "4400";	/* 4 x HMAX: 1H = line_length / pix_clk_hz */
					inherent_gain = "1";
					pix_clk_hz = "297000000";	/* 4 x 74.25 MHz, >= peak pixel rate */
					gain_factor = "10";
					min_gain_val = "0";
					max_gain_val = "480";	/* 48.0 dB */
					step_gain_val = "1";
					default_gain = "0";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					framerate_factor = "1000000";
					min_framerate = "1000000";
					max_framerate = "30000000";
					step_framerate = "1";
					default_framerate = "30000000";
					exposure_factor = "1000000";
					min_exp_time = "10";
					max_exp_time = "30000";
					step_exp_time = "1";
					default_exp_time = "5000";
					embedded_metadata_height = "0";
				};

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						imx568_out7: endpoint {
							vc-id = <1>;		/* set by the FPGA aggregator */
							port-index = <6>;
							bus-width = <4>;
							remote-endpoint = <&imx568_csi_in7>;
						};
					};
				};
			};
		};
		};
	};

	tegra-camera-platform {
		compatible = "nvidia, tegra-camera-platform";
		num_csi_lanes = <16>;
		max_lane_speed = <1500000>;
		min_bits_per_pixel = <12>;
		vi_peak_byte_per_pixel = <2>;
		vi_bw_margin_pct = <25>;
		max_pixel_rate = <2400000>;
		isp_peak_byte_per_pixel = <5>;
		isp_bw_margin_pct = <25>;
		modules {
			module0 {
				badge = "imx568_front_left";
				position = "front";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 30-0036";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@0/imx568_l@36";
				};
			};
			module1 {
				badge = "imx568_front_right";
				position = "rear";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 30-003d";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@0/imx568_r@3d";
				};
			};
			module2 {
				badge = "imx568_rear_left";
				position = "topleft";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 31-0036";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@1/imx568_l@36";
				};
			};
			module3 {
				badge = "imx568_rear_right";
				position = "topright";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 31-003d";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@1/imx568_r@3d";
				};
			};
			module4 {
				badge = "imx568_left_left";
				position = "bottomleft";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 32-0036";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@2/imx568_l@36";
				};
			};
			module5 {
				badge = "imx568_left_right";
				position = "bottomright";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 32-003d";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@2/imx568_r@3d";
				};
			};
			module6 {
				badge = "imx568_right_left";
				position = "centerleft";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 33-0036";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@3/imx568_l@36";
				};
			};
			module7 {
				badge = "imx568_right_right";
				position = "centerright";
				orientation = "1";
				drivernode0 {
					pcl_id = "v4l2_sensor";
					devname = "imx568 33-003d";
					proc-device-tree = "/proc/device-tree/i2c@3180000/tca9546@70/i2c@3/imx568_r@3d";
				};
			};
		};
	};
};
