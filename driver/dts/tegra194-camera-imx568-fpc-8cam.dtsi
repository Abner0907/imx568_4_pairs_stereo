		i2c@1 {	/* FPC 1: stereo 1 (rear) */
			reg = <1>;
			i2c-mux,deselect-on-exit;
			#address-cells = <1>;
			#size-cells = <0>;

			imx568_2: imx568_l@36 {	/* stereo 1 left */
