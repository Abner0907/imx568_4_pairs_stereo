		regulator-max-microvolt = <5000000>;
		gpio = <&cam_exp 5 GPIO_ACTIVE_HIGH>;	/* TCA6416A P05 */
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;			/* FPGA stays configured */
		startup-delay-us = <50000>;		/* FPGA config from SPI flash */
	};

	vdd_stereo1: regulator-vdd-stereo1 {	/* PWR_EN: FPGA sequences both sensors */
		compatible = "regulator-fixed";
		regulator-name = "vdd-stereo1";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&cam_exp 1 GPIO_ACTIVE_HIGH>;	/* TCA6416A P01 */
		enable-active-high;
		vin-supply = <&vin_stereo1>;
		startup-delay-us = <25000>;		/* 3 x 2 ms rails + 5 ms + XCLR/INCK + margin */
		off-on-delay-us = <20000>;		/* ordered power-down (stereo_ctrl.v) */
	};
	vin_stereo2: regulator-vin-stereo2 {	/* 5 V to FPC 2: FPGA + board supplies */
